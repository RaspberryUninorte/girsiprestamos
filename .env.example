# Supabase project settings (Project Settings > API)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Server-only: Supabase service role key (bypasses RLS, never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# SMTP para todos los correos de la app (codigo de verificacion y avisos de prestamos).
# Con Gmail: smtp.gmail.com, puerto 465, la direccion Gmail y una contrasena de aplicacion.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=GIRSI Préstamos

# Random secret that authenticates Vercel Cron's daily overdue-loan check
CRON_SECRET=
