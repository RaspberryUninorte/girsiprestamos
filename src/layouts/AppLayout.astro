---
import Layout from './Layout.astro';
import { navItemsFor, isActiveNavItem } from '../lib/nav';

interface Props {
  title: string;
  breadcrumb?: string;
  description?: string;
}

const { title, breadcrumb = title, description } = Astro.props;
const { user, profile } = Astro.locals;
const pathname = Astro.url.pathname;
const navItems = navItemsFor(profile?.role);

const email = user?.email ?? '';
const displayName = profile?.full_name || email;
const initials = displayName.slice(0, 2).toUpperCase();
const roleLabel = profile?.role === 'admin' ? 'Admin Lab' : 'Estudiante';
---

<!-- Todas las pantallas con AppLayout requieren sesión: no se indexan. -->
<Layout title={title} description={description} noindex>
  <div class="flex flex-col min-h-screen w-full lg:flex-row">
    <!-- Desktop sidebar -->
    <aside class="hidden lg:flex lg:fixed lg:left-0 lg:top-0 lg:h-full lg:w-64 bg-surface-container-lowest shadow-[0_1px_8px_rgba(0,0,0,0.04)] z-50 flex-col justify-between">
      <div class="flex flex-col">
        <div class="px-space-lg py-space-lg flex flex-col items-start gap-1">
          <img src="/girsi-logo.png" alt="GIRSI" class="h-11 w-auto object-contain" />
          <span class="font-label-md text-label-md text-on-surface-variant">Préstamos de equipos</span>
        </div>
        <div class="px-space-md pt-space-md">
          <span class="px-space-sm font-label-sm text-label-sm uppercase tracking-wider text-outline">Plataforma</span>
          <nav class="mt-space-xs flex flex-col gap-space-xs">
            {navItems.map((item) => {
              const active = isActiveNavItem(pathname, item.href);
              return (
                <a
                  href={item.href}
                  class:list={[
                    'flex items-center gap-space-md px-space-md py-space-sm rounded-lg font-label-md text-label-md transition-all',
                    active
                      ? 'bg-primary-container text-on-primary font-semibold shadow-sm'
                      : 'text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface',
                  ]}
                >
                  <span class="material-symbols-outlined text-[20px]">{item.icon}</span>
                  <span>{item.label}</span>
                </a>
              );
            })}
          </nav>
        </div>
      </div>
      <div class="p-space-md bg-surface-container-low">
        <div class="flex items-center justify-between p-space-sm rounded-lg bg-surface-container-lowest shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
          <div class="flex items-center gap-space-sm min-w-0">
            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center flex-shrink-0">
              <span class="font-label-sm text-label-sm text-on-primary">{initials}</span>
            </div>
            <div class="flex flex-col min-w-0">
              <span class="font-label-md text-label-md text-on-surface leading-tight truncate">{displayName}</span>
              <span class="font-label-sm text-label-sm text-on-surface-variant">{roleLabel}</span>
            </div>
          </div>
          <form method="POST" action="/api/logout">
            <button
              type="submit"
              title="Cerrar sesión"
              class="text-on-surface-variant hover:text-on-surface p-space-xs rounded-lg hover:bg-surface-container"
            >
              <span class="material-symbols-outlined text-[20px]">logout</span>
            </button>
          </form>
        </div>
      </div>
    </aside>

    <div class="flex-1 lg:pl-64 flex flex-col min-h-screen">
      <!-- Mobile header -->
      <header class="lg:hidden fixed top-0 w-full z-50 bg-surface/85 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)] pt-safe">
        <div class="h-16 px-4 flex items-center justify-between gap-2">
          <div class="flex items-center gap-2.5 min-w-0 flex-1">
            <img src="/girsi-logo.png" alt="GIRSI" class="h-7 w-auto object-contain flex-shrink-0" />
            <span class="font-label-sm text-label-sm text-on-surface-variant truncate">{breadcrumb}</span>
          </div>
          <div class="flex items-center gap-1 flex-shrink-0">
            <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center shadow-sm">
              <span class="font-label-sm text-label-sm text-on-primary">{initials}</span>
            </div>
            <form method="POST" action="/api/logout">
              <button
                type="submit"
                title="Cerrar sesión"
                class="text-on-surface-variant hover:text-on-surface p-space-xs rounded-lg hover:bg-surface-container min-w-[44px] min-h-[44px] flex items-center justify-center"
              >
                <span class="material-symbols-outlined text-[20px]">logout</span>
              </button>
            </form>
          </div>
        </div>
      </header>

      <main class="flex-1 w-full pt-16 lg:pt-space-xl pb-24 lg:pb-space-xl px-space-md lg:px-space-xl bg-surface">
        <slot />
      </main>
    </div>

    <!-- Mobile bottom nav -->
    <nav class="lg:hidden fixed bottom-0 w-full z-50 pb-safe bg-surface/90 backdrop-blur-xl shadow-[0_-2px_12px_rgba(0,0,0,0.05)]">
      <div class="h-16 px-1 flex items-center justify-around">
        {navItems.map((item) => {
          const active = isActiveNavItem(pathname, item.href);
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class="flex-1 max-w-[96px] min-w-0 flex flex-col items-center justify-center gap-1 py-1.5 min-h-[44px] group"
            >
              <!-- El indicador va solo detrás del ícono: así la etiqueta usa todo el ancho
                   del ítem (~58px con 6 secciones en un teléfono de 360px). -->
              <span
                class:list={[
                  'flex items-center justify-center w-12 h-7 rounded-full transition-colors',
                  active ? 'bg-primary-container text-on-primary shadow-sm' : 'text-on-surface-variant group-hover:text-on-surface',
                ]}
              >
                <span class="material-symbols-outlined text-[22px]">{item.icon}</span>
              </span>
              <span
                class:list={[
                  'font-label-sm text-[11px] leading-tight truncate max-w-full',
                  active ? 'text-primary font-semibold' : 'text-on-surface-variant',
                ]}
              >
                {item.shortLabel ?? item.label}
              </span>
            </a>
          );
        })}
      </div>
    </nav>
  </div>
</Layout>
