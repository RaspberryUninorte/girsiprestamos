---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { DEFAULT_DESCRIPTION, OG_IMAGE_PATH, SITE_NAME, siteOrigin } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  /** Páginas privadas (detrás de login): no deben indexarse. */
  noindex?: boolean;
}

const { title = 'GIRSI', description = DEFAULT_DESCRIPTION, noindex = false } = Astro.props;

const origin = siteOrigin(Astro.url, Astro.site);
// Canónico sin query string: /prestamos?status=activo apunta a /prestamos.
const canonicalUrl = new URL(Astro.url.pathname, origin).toString();
const ogImageUrl = new URL(OG_IMAGE_PATH, origin).toString();
const fullTitle = `${title} · ${SITE_NAME}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${origin}/#organization`,
      name: 'GIRSI — Semillero de Investigación',
      url: origin,
      logo: new URL('/girsi-logo.png', origin).toString(),
    },
    {
      '@type': 'WebSite',
      '@id': `${origin}/#website`,
      name: SITE_NAME,
      url: origin,
      inLanguage: 'es',
      publisher: { '@id': `${origin}/#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': canonicalUrl,
      url: canonicalUrl,
      name: fullTitle,
      description,
      inLanguage: 'es',
      isPartOf: { '@id': `${origin}/#website` },
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="GIRSI — Préstamos de equipos del laboratorio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Se escapa "<" para que un título con un cierre de script (ej. nombre de proyecto) no rompa la etiqueta. -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
    <ClientRouter />
  </head>
  <body class="bg-surface font-body-md text-on-surface flex flex-col min-h-screen">
    <div id="nav-progress" role="progressbar" aria-label="Cargando" aria-hidden="true"></div>
    <slot />
  </body>
</html>

<script>
  // Indicadores de carga para toda la app. Con <ClientRouter /> los enlaces y
  // formularios viajan por fetch, así que el navegador no muestra su indicador
  // propio y una petición lenta (ej. subir fotos de un préstamo) parecía
  // congelada. Se muestra una barra arriba y un spinner en el botón enviado,
  // que además queda deshabilitado para evitar envíos dobles.

  function startLoading(submitter?: Element | null) {
    const bar = document.getElementById('nav-progress');
    bar?.classList.add('is-active');
    bar?.setAttribute('aria-hidden', 'false');

    if (!(submitter instanceof HTMLButtonElement) || submitter.classList.contains('is-loading')) return;
    submitter.classList.add('is-loading');
    submitter.setAttribute('aria-busy', 'true');
    const spinner = document.createElement('span');
    spinner.className = 'btn-spinner';
    spinner.setAttribute('aria-hidden', 'true');
    submitter.prepend(spinner);
    // Se deshabilita después de que el navegador arma los datos del formulario.
    setTimeout(() => (submitter.disabled = true));
  }

  function stopLoading() {
    const bar = document.getElementById('nav-progress');
    bar?.classList.remove('is-active');
    bar?.setAttribute('aria-hidden', 'true');
    document.querySelectorAll<HTMLButtonElement>('button.is-loading').forEach((button) => {
      button.classList.remove('is-loading');
      button.removeAttribute('aria-busy');
      button.disabled = false;
      button.querySelector('.btn-spinner')?.remove();
    });
  }

  function submitterOf(element: Element | undefined | null): Element | null {
    if (!element) return null;
    if (element instanceof HTMLFormElement) return element.querySelector('button[type="submit"], button:not([type])');
    return element;
  }

  // Navegaciones y envíos manejados por el ClientRouter.
  document.addEventListener('astro:before-preparation', (event) => {
    startLoading(submitterOf((event as Event & { sourceElement?: Element }).sourceElement));
  });
  document.addEventListener('astro:page-load', stopLoading);

  // Envíos que el router no intercepta. Si un onsubmit con confirm() fue
  // cancelado, el evento ya viene con defaultPrevented y no se muestra nada.
  document.addEventListener('submit', (event) => {
    if (event.defaultPrevented) return;
    startLoading(event.submitter ?? submitterOf(event.target as Element));
  });

  // Al volver con el botón "atrás" el navegador puede restaurar la página
  // tal como quedó (con el spinner): se limpia.
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) stopLoading();
  });
</script>
