---
import AppLayout from '../../layouts/AppLayout.astro';
import { formatDate } from '../../lib/dates';

const { supabase } = Astro.locals;

const q = Astro.url.searchParams.get('q')?.trim() ?? '';

const { data } = await supabase
  .from('loans')
  .select('id, student_name, student_code, student_email, started_at, ended_at, items(code, category, model)')
  .eq('status', 'finalizado')
  .order('ended_at', { ascending: false });

let loans = data ?? [];

if (q) {
  const needle = q.toLowerCase();
  loans = loans.filter((l) => {
    const haystack = [l.student_name, l.student_code, l.student_email, (l.items as any)?.code, (l.items as any)?.category]
      .filter(Boolean)
      .join(' ')
      .toLowerCase();
    return haystack.includes(needle);
  });
}
---

<AppLayout title="Historial" description="Historial de préstamos de equipos ya devueltos.">
  <div class="max-w-3xl mx-auto space-y-space-md">
    <div>
      <h1 class="font-headline-xl text-headline-xl-mobile sm:text-headline-xl">Historial</h1>
      <p class="font-body-sm text-body-sm text-on-surface-variant">Préstamos finalizados ({loans.length})</p>
    </div>

    <form method="GET" action="/historial" class="relative w-full">
      <div class="absolute inset-y-0 left-3.5 flex items-center pointer-events-none text-outline">
        <span class="material-symbols-outlined text-[20px]">search</span>
      </div>
      <input
        type="text"
        name="q"
        value={q}
        class="w-full pl-10 pr-4 py-2.5 bg-surface-container-lowest text-on-surface rounded-xl font-body-md text-body-md placeholder:text-outline shadow-sm focus:outline-none focus:bg-surface-container-low transition-colors"
        placeholder="Buscar estudiante, código o equipo..."
      />
    </form>

    <div class="space-y-space-sm">
      {loans.length === 0 && (
        <p class="font-body-sm text-body-sm text-on-surface-variant bg-surface-container-lowest rounded-xl p-space-md shadow-sm">
          {q ? 'No se encontraron préstamos finalizados con esa búsqueda.' : 'Todavía no hay préstamos finalizados.'}
        </p>
      )}

      {loans.map((loan) => {
        const item = loan.items as any;
        return (
          <a href={`/prestamos/${loan.id}`} class="block bg-surface-container-lowest rounded-2xl p-space-md shadow-sm space-y-space-sm hover:shadow transition-shadow">
            <div class="flex items-start justify-between gap-space-sm">
              <div class="flex flex-col min-w-0">
                <h2 class="font-headline-md text-headline-md text-on-surface font-bold truncate">{loan.student_name}</h2>
                <div class="flex items-center gap-1.5 text-on-surface-variant">
                  <span class="font-label-sm text-label-sm">{loan.student_code}</span>
                  <span class="w-1 h-1 rounded-full bg-outline-variant"></span>
                  <span class="font-label-sm text-label-sm text-primary font-semibold">#{item?.code}</span>
                </div>
              </div>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-status-finished-bg text-status-finished-text font-label-sm text-label-sm flex-shrink-0">
                <span class="w-1.5 h-1.5 rounded-full bg-status-finished-dot"></span>
                Finalizado
              </span>
            </div>

            <div class="bg-surface-container-low rounded-xl p-space-sm flex items-center justify-between gap-2">
              <div class="flex flex-col">
                <span class="font-label-sm text-label-sm text-on-surface-variant">Período del préstamo</span>
                <span class="font-label-md text-label-md text-on-surface font-medium">
                  {formatDate(loan.started_at)} — {formatDate(loan.ended_at)}
                </span>
              </div>
              <span class="font-body-sm text-body-sm text-on-surface-variant truncate">{item?.model}</span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</AppLayout>
