# ---------------------------------------------------------------------------
# Lo que SÍ se sube: src/, public/, supabase/migrations/, package.json,
# package-lock.json, astro.config.mjs, tsconfig.json, vercel.json,
# .env.example y README.md. Todo lo demás se genera o es local.
# ---------------------------------------------------------------------------

# Dependencias (se instalan con npm install / en Vercel)
node_modules/

# Salida de build y archivos generados
dist/
.astro/
.vercel/
.output/
*.tsbuildinfo
coverage/

# Variables de entorno: nunca subir claves reales (sí la plantilla)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Configuración local de editores e IDEs
.vscode/
.idea/
*.swp
*.swo

# Instrucciones locales para asistentes de IA (no forman parte de la app)
CLAUDE.md
AGENTS.md
.claude/

# Archivos del sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Temporales
tmp/
*.tmp
